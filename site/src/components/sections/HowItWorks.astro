---
/* The template animates this panel with Lottie files showing third-party
   apps. Here the canyon panel holds a static diagram of the real data path
   instead; the pills highlight one stage at a time. */
const steps = [
  {
    label: 'Dial',
    title: 'A phone dials *384*1234#',
    body: 'Any phone with a SIM card. The phone company, or a company in front of it such as Africa\'s Talking, sends each step to OpenUSSD in its own format.',
  },
  {
    label: 'OpenUSSD',
    title: 'OpenUSSD translates it',
    body: "It turns each phone company's format into one standard message, remembers where the person is in the menu, and sends the message to the app that owns the code, signed so the app knows it is genuine.",
  },
  {
    label: 'Your app',
    title: 'Your app answers with the next screen',
    body: 'It can be written in any programming language. A toolkit for Go helps keep every screen short enough for a phone; one for TypeScript is planned.',
  },
];
---
<section class="hiw" id="how" aria-labelledby="how-title">
  <header class="hiw__header">
    <p class="badge">How it works</p>
    <h2 class="h2 h2--center" id="how-title">
      From a keypad to your app.&nbsp;<em>In three steps.</em>
    </h2>
  </header>

  <div class="hiw__panel" id="hiw-panel" data-step="0">
    <div class="hiw__pills">
      {steps.map((s, i) => (
        <button class={`hiw__pill${i === 0 ? ' is-active' : ''}`} data-step={i} type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="hiw-stage">
          {i + 1}. {s.label}
        </button>
      ))}
    </div>

    <div class="hiw__stage" id="hiw-stage">
      <ol class="flow">
        <li class="flow__node" data-step="0">
          <p class="flow__kicker">1. Dial</p>
          <p class="flow__name">Any phone</p>
          <p class="flow__mono">*384*1234#</p>
          <p class="flow__sub">through the phone company</p>
        </li>
        <li class="flow__link" aria-hidden="true"><span>its own format</span></li>
        <li class="flow__node flow__node--gateway" data-step="1">
          <p class="flow__kicker">2. OpenUSSD</p>
          <p class="flow__name">OpenUSSD</p>
          <ul class="flow__rows">
            <li><b>translates</b> one standard message</li>
            <li><b>remembers</b> where they are</li>
            <li><b>routes</b> to the right app</li>
          </ul>
        </li>
        <li class="flow__link" aria-hidden="true"><span>signed message</span></li>
        <li class="flow__node" data-step="2">
          <p class="flow__kicker">3. Your app</p>
          <p class="flow__name">Your app</p>
          <p class="flow__mono">any language</p>
          <p class="flow__sub">Go toolkit today, TypeScript planned</p>
        </li>
      </ol>

      <div class="flow__captions" aria-live="polite">
        {steps.map((s, i) => (
          <div class={`flow__caption${i === 0 ? ' is-active' : ''}`} data-step={i}>
            <p class="flow__title">{s.title}</p>
            <p class="flow__body">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
