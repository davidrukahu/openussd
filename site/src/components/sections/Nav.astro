---
import Button from '../Button.astro';
import { navLinks, repo } from '../../data/site';
---
<header class="nav-bar" data-nav>
  <nav class="nav" aria-label="Main">
    <a href="/" class="nav__brand nav__wordmark">OpenUSSD</a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu" data-nav-toggle>
      <span class="nav__burger" aria-hidden="true"><i></i><i></i></span>
    </button>

    <div class="nav__right" id="nav-menu" data-nav-menu>
      <ul class="nav__links">
        {navLinks.map((l, i) => (
          <>
            {i > 0 && <li aria-hidden="true" class="nav__sep"></li>}
            <li class="nav__item"><a href={l.href}>{l.label}</a></li>
          </>
        ))}
      </ul>
      <Button href={repo} label="View on GitHub" variant="primary" class="nav__cta" />
    </div>
  </nav>
</header>
