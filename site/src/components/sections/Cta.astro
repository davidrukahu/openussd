---
import Button from '../Button.astro';
import { repo } from '../../data/site';
---
<section class="cta" id="cta" aria-labelledby="cta-title">
  <div class="cta__panel">
    <img class="cta__bg" src="/assets/cta-sunset.jpg" alt="" loading="lazy" />
    <div class="cta__overlay"></div>
    <div class="cta__content">
      <h2 class="cta__title" id="cta-title">Every phone deserves<br /><em>the open web.</em></h2>
      <p class="cta__lede">
        OpenUSSD is free and open source. Developers can try it in a few
        minutes. Organisations that want to use it can get in touch on GitHub.
      </p>
      <Button href={repo} label="Visit the project on GitHub" variant="primary" />
    </div>
  </div>
</section>
