---
import Button from '../Button.astro';
import { repo } from '../../data/site';
---
<section class="cta" id="cta" aria-labelledby="cta-title">
  <div class="cta__panel">
    <img class="cta__bg" src="/assets/cta-sunset.jpg" alt="" loading="lazy" />
    <div class="cta__overlay"></div>
    <div class="cta__content">
      <h2 class="cta__title" id="cta-title">Dial in.<br /><em>Read the federated web.</em></h2>
      <p class="cta__lede">
        Clone the repository, start the gateway and dial the demo shortcode
        from your terminal. Free software, AGPL-3.0-or-later.
      </p>
      <Button href={repo} label="Get the code" variant="primary" />
    </div>
  </div>
</section>
