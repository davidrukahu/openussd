---
import Button from '../Button.astro';
---
<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="hero__panel" id="hero-media">
    <img class="hero__img" src="/assets/hero.jpg" alt="" fetchpriority="high" />
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <h1 class="hero__headline" id="hero-title">
        Reach any phone <em>with a *123# menu</em>.
      </h1>
      <p class="hero__lede">
        OpenUSSD is free software for building the menus people open by
        dialling a code. No app, no smartphone, no internet.
      </p>
      <Button href="#delegation" label="See it on a phone" variant="primary" />
      <p class="hero__status">An early version: it works, but it is not ready for real users yet. Free and open source.</p>
    </div>
  </div>
</section>
