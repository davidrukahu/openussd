---
import { working, notYet, limitations, blob } from '../../data/site';
/* Takes the place of the template's testimonials and pricing. Styled on its
   pricing cards: the first column carries the warm painting, as the
   template's featured plan does. */
---
<section class="status" id="status" aria-labelledby="status-title">
  <header class="status__header">
    <div class="status__heading">
      <p class="badge">Status</p>
      <h2 class="h2" id="status-title">It works today.<br /><em>It is not ready for real users yet.</em></h2>
    </div>
    <p class="status__lede">
      Version 0.1 is an early version. Here is what works, what is missing
      and what to watch out for.
    </p>
  </header>

  <div class="scards">
    <article class="scard scard--featured" aria-labelledby="st-working">
      <h3 class="scard__name" id="st-working">Works today</h3>
      <ul class="scard__list">
        {working.map(([text, href, label]) => (
          <li><i aria-hidden="true"></i><span>{text}{href && <> (<a href={href}>{label}</a>)</>}</span></li>
        ))}
      </ul>
    </article>
    <article class="scard" aria-labelledby="st-notyet">
      <h3 class="scard__name" id="st-notyet">Not yet</h3>
      <ul class="scard__list scard__list--off">
        {notYet.map(([text, href, label]) => (
          <li><i aria-hidden="true"></i><span>{text}{href && <> (<a href={href}>{label}</a>)</>}</span></li>
        ))}
      </ul>
    </article>
    <article class="scard" id="limitations" aria-labelledby="st-limits">
      <h3 class="scard__name" id="st-limits">Known limitations</h3>
      <ul class="scard__list scard__list--text">
        {limitations.map((l) => <li><i aria-hidden="true"></i><span>{l}</span></li>)}
      </ul>
    </article>
  </div>

  <p class="status__note">
    The full plan is in the <a href={`${blob}/ROADMAP.md`}>roadmap</a>. Want to
    help? Read the <a href={`${blob}/CONTRIBUTING.md`}>contributing guide</a>.
  </p>
</section>
