---
import { screens } from '../../data/site';
/* The template's benefit cards, with its product screenshots replaced by
   small panels drawn in the same style from OpenUSSD's own facts. */
const benefits = [
  {
    num: '01',
    mosaic: '/assets/mosaic-a.png',
    title: 'Clinic reminders',
    desc: 'Patients confirm or change a clinic visit by pressing a number. No app, no smartphone, no data bundle.',
    art: 'screen',
    screen: 'Kiambu Health Centre\nYour visit: Tue 14 Oct\n1. Confirm\n2. Change date\n0. Quit',
  },
  {
    num: '02',
    mosaic: '/assets/mosaic-d.png',
    title: 'Savings group balances',
    desc: 'Chama members check their savings and the next meeting from any phone, without calling the treasurer.',
    art: 'screen',
    screen: 'Umoja Chama\nYour savings: KES 12,400\nNext meeting: Sat 2pm\n1. Contributions\n0. Quit',
  },
  {
    num: '03',
    mosaic: '/assets/mosaic-b.png',
    title: 'Community news',
    desc: 'This one works today: the demo reads posts from Mastodon, an open social network, on a basic phone.',
    art: 'screen',
    screen: screens[1].body,
  },
  {
    num: '04',
    mosaic: '/assets/mosaic-c.png',
    title: 'Build once, every network',
    desc: "Each phone company connects differently. OpenUSSD translates, so you build your menu once. Africa's Talking works today.",
    art: 'adapters',
  },
];
const active = '01';
---
<section class="why" id="why" aria-labelledby="why-title">
  <header class="why__header">
    <div class="why__heading">
      <p class="badge">Why it matters</p>
      <h2 class="h2" id="why-title">Every phone can do this.<br />Few can build it.</h2>
    </div>
    <div class="why__lede">
      <p>
        If you have ever dialled a code to check your airtime balance, you have
        used USSD. A text menu appears and you reply with a number. It works on
        every phone, with no internet.
      </p>
      <p>
        In Sub-Saharan Africa, 60% of mobile internet subscribers still use a
        basic or 3G phone
        (<a href="https://www.gsma.com/somic/wp-content/uploads/2025/09/The-State-of-Mobile-Internet-Connectivity-2025-Overview-Report.pdf">GSMA, 2025</a>).
        Building a menu is hard, so mostly banks and phone companies have one.
        OpenUSSD is for everyone else.
      </p>
    </div>
  </header>

  <ul class="why-cards" id="why-cards">
    {benefits.map((b) => (
      <li class={`wcard${b.num === active ? ' is-active' : ''}`} data-index={b.num} tabindex="0">
        <div class="wcard__closed" aria-hidden="true">
          <p class="wcard__number">{b.num}.</p>
          <div class="wcard__mosaic"><img src={b.mosaic} alt="" loading="lazy" /></div>
          <p class="wcard__title-closed">{b.title}</p>
        </div>
        <div class="wcard__open">
          <div class={`wcard__img wart wart--${b.art}`} aria-hidden="true">
            {b.art === 'adapters' && (
              <>
                <span class="wart__tiles">
                  <span class="wart__tile is-on">Africa's<br />Talking</span>
                  <span class="wart__dots"></span>
                  <span class="wart__tile">MTN</span>
                  <span class="wart__dots"></span>
                  <span class="wart__tile">SMPP</span>
                </span>
                <span class="wart__pill"><i class="wart__dot"></i>live today<i class="wart__dot wart__dot--off"></i>planned</span>
              </>
            )}
            {b.art === 'screen' && (
              <span class="wart__screen">{b.screen}</span>
            )}
          </div>
          <div class="wcard__content">
            <h3 class="wcard__title">{b.title}</h3>
            <p class="wcard__desc">{b.desc}</p>
          </div>
        </div>
      </li>
    ))}
  </ul>
  <p class="why__note">
    The clinic and chama screens are examples. The community news screen is
    real output from the demo.
  </p>
</section>
